# MODELE de configuration des secrets — AUCUNE VALEUR REELLE ICI.
#
# Ce fichier est versionne dans Git ; le vrai `.streamlit/secrets.toml` ne
# l'est jamais (voir .gitignore). Pour une installation locale : copier ce
# fichier en `.streamlit/secrets.toml` et remplacer les valeurs.
#
# Chez l'hebergeur, ne PAS deposer ce fichier : utiliser le mecanisme de
# secrets du service. Sur Render, un "Secret File" nomme exactement
# `secrets.toml` est monte dans /etc/secrets/ et recopie au demarrage par
# docker-entrypoint.sh.
#
# DEUX INSCRIPTIONS AZURE DISTINCTES, ne pas les confondre :
#
#   [microsoft_app]  -> l'APPLICATION ecrit dans SharePoint sans humain
#                       (mode "app-only", permissions d'application avec
#                       consentement administrateur).
#   [auth.microsoft] -> l'UTILISATEUR humain se connecte pour ouvrir
#                       l'appli (OpenID Connect, aucune permission Graph).
#
# Elles sont volontairement separees : la premiere detient des droits
# d'ecriture larges, il serait malsain de partager son secret avec un flux
# de connexion utilisateur, et leurs secrets doivent pouvoir tourner
# independamment.


# ---------------------------------------------------------------------
# 1. Sauvegarde automatique SharePoint (voir services/sharepoint_auth.py)
# ---------------------------------------------------------------------
[microsoft_app]
tenant_id = "00000000-0000-0000-0000-000000000000"
client_id = "00000000-0000-0000-0000-000000000000"
client_secret = "REMPLACER — valeur affichee une seule fois par le portail Azure"
site_id = "REMPLACER — identifiant du site SharePoint cible"
root_folder = "AuditsOPTHELIOS"


# ---------------------------------------------------------------------
# 2. Connexion des utilisateurs (voir services/app_auth.py)
# ---------------------------------------------------------------------
# Reglages partages par tous les fournisseurs.
[auth]
# URL ABSOLUE de l'appli suivie de /oauth2callback. Doit correspondre AU
# CARACTERE PRES a l'URI de redirection declaree dans le portail Azure.
# En local :        http://localhost:8501/oauth2callback
# Sur Render :      https://<nom-du-service>.onrender.com/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"

# Chaine aleatoire servant a signer le cookie de session. A generer soi-meme
# et a garder secrete — la changer deconnecte tout le monde :
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REMPLACER — chaine aleatoire de 64 caracteres hexadecimaux"

# Fournisseur Microsoft Entra ID.
[auth.microsoft]
client_id = "00000000-0000-0000-0000-000000000000"
client_secret = "REMPLACER — secret de l'inscription dediee a la connexion"
# L'identifiant du tenant dans cette URL restreint la connexion aux seuls
# comptes OPT'HELIOS. Ne PAS utiliser "common" ou "organizations", qui
# ouvriraient l'appli aux comptes de n'importe quelle entreprise.
server_metadata_url = "https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0/.well-known/openid-configuration"
